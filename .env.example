# Backend configuration. Copy to `.env` for local development.
# In production (Cloudflare) set these with `npx wrangler secret put <NAME>` (secrets)
# or in wrangler.jsonc "vars" (non-secret values) — never commit real values.

# Admin dashboard (/admin) password.
ADMIN_PASSWORD=
# Random string, at least 32 characters, used to encrypt the admin session cookie.
SESSION_SECRET=

# Email via Resend (https://resend.com). Leave empty to store enquiries without sending email.
RESEND_API_KEY=
# Sender, on a domain verified in Resend, e.g. "Lean Export <noreply@yourdomain.com>".
MAIL_FROM=
# Where new enquiry notifications go (comma-separated). Defaults to businessConfig.email.
SALES_EMAIL=
